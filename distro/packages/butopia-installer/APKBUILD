# Maintainer: Butopia Contributors <maintainers@butopia.invalid>
pkgname=butopia-installer
pkgver=0.1.0
pkgrel=0
pkgdesc="Butopia disk installation entry point"
url="https://github.com/culpen90/Butopia"
arch="noarch"
license="MIT"
depends="alpine-conf butopia-base"
options="!check"
source="setup-butopia"

package() {
	install -Dm0755 "$srcdir/setup-butopia" "$pkgdir/sbin/setup-butopia"
	ln -s setup-butopia "$pkgdir/sbin/butopia-install"
}

