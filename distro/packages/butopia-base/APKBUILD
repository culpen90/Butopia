# Maintainer: Butopia Contributors <maintainers@butopia.invalid>
pkgname=butopia-base
pkgver=0.1.0
pkgrel=0
pkgdesc="Core commands, defaults, and boot readiness service for Butopia"
url="https://github.com/culpen90/Butopia"
arch="noarch"
license="MIT"
depends="openrc"
options="!check"
source="
	LICENSE
	README
	butopia
	butopia-profile.sh
	butopia-ready.initd
	"

package() {
	install -Dm0755 "$srcdir/butopia" "$pkgdir/usr/bin/butopia"
	install -Dm0644 "$srcdir/butopia-profile.sh" "$pkgdir/etc/profile.d/10-butopia.sh"
	install -Dm0755 "$srcdir/butopia-ready.initd" "$pkgdir/etc/init.d/butopia-ready"
	install -Dm0644 "$srcdir/README" "$pkgdir/usr/share/doc/butopia/README"
	install -Dm0644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/butopia-base/LICENSE"
}

