# Maintainer: Butopia Contributors <maintainers@butopia.invalid>
pkgname=butopia-release
pkgver=0.1.0
pkgrel=0
pkgdesc="Butopia Linux release identity and Alpine compatibility data"
url="https://github.com/culpen90/Butopia"
arch="noarch"
license="MIT"
depends="alpine-keys"
provides="alpine-release=3.24.1-r0"
provider_priority=100
replaces="alpine-release alpine-baselayout"
replaces_priority=100
options="!check"
source="
	alpine-release
	butopia-release
	issue
	motd
	os-release
	secfixes-alpine
	"

package() {
	install -Dm0644 "$srcdir/alpine-release" "$pkgdir/etc/alpine-release"
	install -Dm0644 "$srcdir/butopia-release" "$pkgdir/etc/butopia-release"
	install -Dm0644 "$srcdir/issue" "$pkgdir/etc/issue"
	install -Dm0644 "$srcdir/motd" "$pkgdir/etc/motd"
	install -Dm0644 "$srcdir/os-release" "$pkgdir/usr/lib/os-release"
	install -Dm0644 "$srcdir/secfixes-alpine" "$pkgdir/etc/secfixes.d/alpine"
	ln -s ../usr/lib/os-release "$pkgdir/etc/os-release"
}

