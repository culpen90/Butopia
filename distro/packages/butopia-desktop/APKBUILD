# Maintainer: Butopia Contributors <maintainers@butopia.invalid>
pkgname=butopia-desktop
pkgver=0.1.0
pkgrel=0
pkgdesc="Butopia graphical live desktop, branding, and session defaults"
url="https://github.com/culpen90/Butopia"
arch="noarch"
license="MIT"
depends="
	adwaita-xfce-icon-theme
	adw-gtk3
	butopia-base
	dbus
	dbus-openrc
	dbus-x11
	elogind
	elogind-openrc
	eudev
	eudev-openrc
	firefox-esr
	font-dejavu
	font-noto
	font-noto-emoji
	gvfs
	gvfs-smb
	lightdm
	lightdm-gtk-greeter
	lightdm-openrc
	mesa-dri-gallium
	mesa-egl
	mousepad
	network-manager-applet
	networkmanager
	networkmanager-openrc
	networkmanager-wifi
	polkit-elogind
	ristretto
	thunar-volman
	udev-init-scripts
	udev-init-scripts-openrc
	udisks2
	xf86-input-libinput
	xf86-video-amdgpu
	xf86-video-ati
	xf86-video-intel
	xf86-video-nouveau
	xf86-video-vesa
	xfce-polkit
	xfce4
	xfce4-power-manager
	xfce4-screensaver
	xfce4-screenshooter
	xfce4-terminal
	xfce4-whiskermenu-plugin
	xinit
	xorg-server
	yad
	"
options="!check"
install="$pkgname.pre-install $pkgname.post-install"
source="
	Butopia-Firefox.desktop
	Butopia-Home.desktop
	Butopia-Install.desktop
	Butopia-Terminal.desktop
	Butopia-Welcome-Launcher.desktop
	butopia-desktop-init
	butopia-desktop-init.desktop
	butopia-genesis.png
	butopia-gui-ready.initd
	butopia-welcome
	butopia-welcome.desktop
	butopia.svg
	lightdm-butopia.conf
	lightdm-gtk-greeter-butopia.conf
	xfce4-desktop.xml
	xsettings.xml
	"

package() {
	install -Dm0644 "$srcdir/butopia-genesis.png" \
		"$pkgdir/usr/share/backgrounds/butopia/butopia-genesis.png"
	install -Dm0644 "$srcdir/butopia.svg" \
		"$pkgdir/usr/share/icons/hicolor/scalable/apps/butopia.svg"

	install -Dm0755 "$srcdir/butopia-welcome" "$pkgdir/usr/bin/butopia-welcome"
	install -Dm0755 "$srcdir/butopia-desktop-init" "$pkgdir/usr/bin/butopia-desktop-init"
	install -Dm0755 "$srcdir/butopia-gui-ready.initd" \
		"$pkgdir/etc/init.d/butopia-gui-ready"

	install -Dm0644 "$srcdir/lightdm-butopia.conf" \
		"$pkgdir/etc/lightdm/lightdm.conf.d/50-butopia.conf"
	install -Dm0644 "$srcdir/lightdm-gtk-greeter-butopia.conf" \
		"$pkgdir/etc/lightdm/lightdm-gtk-greeter.conf.d/50-butopia.conf"
	install -Dm0644 "$srcdir/butopia-desktop-init.desktop" \
		"$pkgdir/etc/xdg/autostart/butopia-desktop-init.desktop"
	install -Dm0644 "$srcdir/butopia-welcome.desktop" \
		"$pkgdir/etc/xdg/autostart/butopia-welcome.desktop"

	config_dir="$pkgdir/usr/share/butopia/skel/.config/xfce4/xfconf/xfce-perchannel-xml"
	install -Dm0644 "$srcdir/xfce4-desktop.xml" "$config_dir/xfce4-desktop.xml"
	install -Dm0644 "$srcdir/xsettings.xml" "$config_dir/xsettings.xml"

	desktop_dir="$pkgdir/usr/share/butopia/skel/Desktop"
	for launcher in \
		Butopia-Firefox.desktop \
		Butopia-Home.desktop \
		Butopia-Install.desktop \
		Butopia-Terminal.desktop \
		Butopia-Welcome-Launcher.desktop; do
		target=$launcher
		test "$launcher" != Butopia-Welcome-Launcher.desktop || target=Butopia-Welcome.desktop
		install -Dm0755 "$srcdir/$launcher" "$desktop_dir/$target"
	done
}

